# Copy to .env and adjust. Every value here has a working default in
# docker-compose.yml, so `docker compose up` works with no .env at all.

# --- Ports published on the host ---
WEB_PORT=8080
API_PORT=3000
POSTGRES_PORT=5433
REDIS_PORT=6380
REDIS_UI_PORT=5540

# --- Database ---
POSTGRES_USER=leaguepicks
POSTGRES_PASSWORD=leaguepicks
POSTGRES_DB=leaguepicks

# --- API ---
NODE_ENV=development
JWT_SECRET=dev-secret-change-me
LEADERBOARD_TTL_SECONDS=30
# Exposes /api/admin/* endpoints used to demo settlement. Never enable in prod.
DEV_TOOLS=true

# --- Worker ---
# Every *_CRON accepts several expressions separated by `;` — the comma is
# already taken by cron's own field lists. Each one is scheduled against the
# same job, so splitting on the hour field gives a job two cadences:
#
#   INGEST_CRON=*/10 11-23,0-1 * * *; */30 2-10 * * *
#
# is every 10 min from 11AM through 2AM, every 30 min from 2AM through 11AM.
# Overlapping ranges are safe: each job skips a tick it is already running.
SETTLEMENT_CRON=*/1 * * * *
INGEST_CRON=*/10 11-23,0-1 * * *; */30 2-10 * * *
# Which clock those hour fields mean. The worker container has no TZ of its
# own, so leaving this unset would put every hour range on UTC.
CRON_TIMEZONE=America/New_York
# Pull the NFL schedule and scores from ESPN's public endpoints. On by default:
# no fixtures are generated locally, so without this there are no games at all.
INGEST_ENABLED=true
# Season to ingest. Defaults to the current NFL season — the year, except before
# March, when the season that began the previous September is still running.
INGEST_SEASON=

# --- SharpAPI lines (sharpapi.io) ---
# Do NOT put the key here. It is injected from 1Password at run time:
#
#   ./scripts/compose.sh up -d
#
# which resolves the reference in .env.op. Setting SHARP_API_KEY in this file
# would put a live credential on disk in plaintext.
SHARP_API_BASE=https://api.sharpapi.io/api/v1
SHARP_LEAGUE=nfl
# Preference order when several books price the same game. The free tier serves
# two. The first book that priced a game wins, so lines don't flap between books.
SHARP_BOOKS=draftkings,fanduel
# Free tier allows 12/min. Requests are spaced to stay under this.
SHARP_REQUESTS_PER_MINUTE=12
# Free-tier data is delayed 60s, so caching below that buys nothing.
SHARP_CACHE_TTL_SECONDS=90
ODDS_CRON=*/5 11-23 * * *; */30 0-10 * * *

# --- Game modes ---
# Offer the legacy pick-based modes (Pick'em, Confidence, Survivor) at creation.
LEGACY_POOL_MODES=false
