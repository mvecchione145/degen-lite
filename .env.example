# Copy to .env and adjust. Every value here has a working default in
# docker-compose.yml, so `docker compose up` works with no .env at all.

# --- Ports published on the host ---
WEB_PORT=8080
API_PORT=3000
POSTGRES_PORT=5433
REDIS_PORT=6380
REDIS_UI_PORT=5540

# --- Database ---
POSTGRES_USER=leaguepicks
POSTGRES_PASSWORD=leaguepicks
POSTGRES_DB=leaguepicks

# --- API ---
NODE_ENV=development
JWT_SECRET=dev-secret-change-me
LEADERBOARD_TTL_SECONDS=30
# Exposes /api/admin/* endpoints used to demo settlement. Never enable in prod.
DEV_TOOLS=true

# --- Worker ---
SETTLEMENT_CRON=*/1 * * * *
INGEST_CRON=*/10 * * * *
# Pull real NFL schedules/scores from ESPN's public endpoints. Off by default so
# the demo runs entirely on seeded data with no network access.
INGEST_ENABLED=false
# Season to ingest when INGEST_ENABLED=true. Defaults to the current year.
INGEST_SEASON=
