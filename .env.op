# 1Password secret references, resolved at run time by `op run`.
#
# This file contains no secrets — only pointers — so it is safe to commit.
# The values are fetched from your vault when you run:
#
#   ./scripts/compose.sh up -d
#
# which wraps `op run --env-file=.env.op -- docker compose ...`.
#
# Shell environment beats compose's own .env file during interpolation, so the
# resolved value is what lands in ${SHARP_API_KEY} in docker-compose.yml.

SHARP_API_KEY=op://Private/Sharp API/password
